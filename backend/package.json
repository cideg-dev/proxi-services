{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Proxi-Services platform",
  "main": "server.js",
  "scripts": {
    "prestart": "node file_structure_check.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom=src/**/*.{js,jsx}",
    "migrate": "node-pg-migrate",
    "migrate:up": "npx node-pg-migrate up 2>/dev/null || exit 0",
    "migrate:down": "node-pg-migrate down",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "devDependencies": {
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "keywords": [
    "backend",
    "api",
    "express",
    "postgres",
    "socket.io",
    "authentication",
    "services",
    "artisans"
  ],
  "author": "Proxi-Services Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "redis": "^5.9.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.0",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.22",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  }
}
